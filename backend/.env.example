PORT=5000

# Use a MongoDB URI for your own development database. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Absolute path to a Firebase Admin service-account JSON file stored outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/firebase-admin-service-account.json

# Create a key in Google AI Studio. Keep it private.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional comma-separated browser origins for a deployed web client.
# Leave unset during local native Flutter development.
# CORS_ORIGINS=https://your-app.example
EMOTION_SERVICE_URL=http://127.0.0.1:8000